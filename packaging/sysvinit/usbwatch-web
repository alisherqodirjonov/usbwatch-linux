#!/bin/sh
### BEGIN INIT INFO
# Provides:          usbwatch-web
# Required-Start:    $local_fs $network usbwatch
# Required-Stop:     $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: USBWatch web console
### END INIT INFO

NAME=usbwatch-web
ARGS="web --user usbwatch"
RUNAS=root            # binds the socket, then drops to user 'usbwatch' itself
. "$(dirname "$0")/usbwatch-common" 2>/dev/null || . /etc/init.d/usbwatch-common
